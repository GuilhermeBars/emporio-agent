# Copy to .env. Never commit .env.
# Leave blank for OpenAI/Groq via one API key, or set to codex (no API key required).
LLM_PROVIDER=
OPENAI_API_KEY=
GROQ_API_KEY=
# Explicit overrides; leave blank for the selected provider's defaults.
OPENAI_BASE_URL=
MODEL=
# Codex CLI executable (default: codex); uses the CLI's existing authentication.
CODEX_BIN=
# Codex request timeout in seconds (default: 180).
CODEX_TIMEOUT=
# Optional Codex model override; blank uses the CLI's default model.
CODEX_MODEL=
DEBUG=0
